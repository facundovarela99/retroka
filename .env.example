NODE_ENV=development
PORT=3000
APP_NAME=retroka
APP_URL=http://localhost:3000/retroka

# Usar un valor aleatorio de al menos 32 bytes. No reutilizar otras claves.
SESSION_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-bytes
SESSION_MAX_AGE_MS=3600000
AUTH_BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

DB_HOST=localhost
DB_NAME=retroka
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# En testing/test/production las imagenes se almacenan en Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
