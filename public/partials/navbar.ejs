<%
const cantidad = typeof carrito !== 'undefined' && Array.isArray(carrito)
    ? cantidadProductos(carrito)
    : 0;


function cantidadProductos(productos){
    let cant = 0;
    for (p of productos){
        cant+=p.cantidad
    }
    return Number(cant);
}

%>
<nav>
    <ul>
        <li><a href="<% url('/productos') %>">Productos</a></li>
        <% if (user) { %>
        <li><form method="post" action="/retroka/logout"><button class="btn btn-primary" type="submit">Cerrar sesión</button></form></li>
        <% } else { %>
        <li><a href="/retroka/login"><button type="button" class="btn btn-primary">Iniciar sesión</button></a></li>
        <% } %>
        <li><button id="btn-carrito" 
                    class="btn btn-primary btn-sm" 
                    type="button" 
                    data-bs-toggle="offcanvas"
                    data-bs-target="#offcanvasRight" 
                    aria-controls="offcanvasRight">Carrito <span id="carrito-cantidad"><%= cantidad %></span></button></li>
    </ul>
</nav>
<script>
    console.log(document.getElementById('carrito-cantidad').textContent)
</script>
