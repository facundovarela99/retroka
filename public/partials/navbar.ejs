<%
var cantidad = 0;

if (typeof carrito !== 'undefined' && Array.isArray(carrito) && carrito.length > 0){
    for (p of carrito){
        cantidad+=p.cantidad
    }
}

%>
<nav>
    <ul>
        <li><a href="<%= url('/productos') %>">Productos</a></li>
        <% if (user) { %>
        <li>
            <form method="post" action="<%= url('/logout') %>">
                <input type="hidden" name="csrf_token" value="<%= typeof csrf_token !== 'undefined' ? csrf_token : '' %>">
                <button class="btn btn-primary" type="submit">Cerrar sesion</button>
            </form>
        </li>
        <% } else { %>
        <li><a href="<%= url('/login') %>"><button type="button" class="btn btn-primary">Iniciar sesion</button></a></li>
        <% } %>
        <li><button id="btn-carrito"
                    class="btn btn-primary btn-sm"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#offcanvasRight"
                    aria-controls="offcanvasRight">Carrito <span id="carrito-cantidad"><%= cantidad %></span></button></li>
    </ul>
</nav>
