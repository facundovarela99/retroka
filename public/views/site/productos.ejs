<%
const esAdministrador = Boolean(user?.is_admin);
const productosDisponibles = Array.isArray(productos) ? productos : [];
const productosVisibles = esAdministrador
    ? productosDisponibles
    : productosDisponibles.filter((producto) => producto.categoria !== null && producto.categoria !== undefined);
const imagenGenerica = '/assets/img/product-placeholder.svg';
%>
<!DOCTYPE html>
<html lang="es">
<%- include('../../partials/site/meta') %>
<body id="body-productos">

    <%- include('../../partials/site/navbar') %>

    <main class="products-main w-100 mx-auto">

        <% if (product_message?.message) { %>
        <div
            class="alert <%= product_message.type === 'success' ? 'alert-success' : 'alert-danger' %> alert-dismissible"
            role="alert"
        >
            <div class="pe-4">
                <%= product_message.message %>
            </div>

            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
        <% } %>


        <% if (auth_message !== null && auth_message?.message) { %>
            <div
                class="alert <%= auth_message.type === 'success'
                    ? 'alert-success'
                    : 'alert-danger' %>"
                role="<%= auth_message.type === 'error' ? 'alert' : 'status' %>"
            >
                <%= auth_message.message %>
            </div>
        <% } %>

        <header class="products-heading d-flex justify-content-between align-items-end">
            <div>
                <h1 id="products-title" class="products-title mb-0">
                    New Arrivals
                </h1>

                <p class="products-subtitle mb-0">
                    Latest drops in urban streetwear.
                </p>
            </div>

            <div class="d-none d-md-flex gap-2" aria-label="Controles de productos">
                <button class="products-control-button" type="button">
                    Filtros
                </button>

                <button class="products-control-button" type="button">
                    Ordenar: recientes
                </button>
            </div>
        </header>

        <section aria-labelledby="products-title">
            <% if (productosVisibles.length > 0) { %>
                <div class="row g-4" role="list">
                    <% productosVisibles.forEach((producto) => { %>
                        <%
                        const variantesProducto = Array.isArray(producto.variantes)
                            ? producto.variantes
                            : [];
                        const categoriaProducto = producto.categoria_producto || producto.categoria || 'Sin categoría';
                        const productoSinStock = Number.parseInt(producto.stock, 10) <= 0;
                        %>
                        <div class="col-12 col-sm-6 col-lg-4 col-xl-3" role="listitem">
                            <article
                                class="product-card d-flex flex-column h-100 overflow-hidden"
                                aria-labelledby="product-name-<%= producto.id %>"
                            >

                                <div class="product-variant-preview-grid product-variant-carousel" data-carousel aria-label="Imágenes de <%= producto.nombre %>">
                                    <div class="product-variant-track" data-track>
                                        <% const slides = variantesProducto.length > 0 ? variantesProducto : [{ imagen_archivo: imagenGenerica, color: '', talle: '' }]; %>
                                        <% slides.forEach((variante) => { %>
                                            <% const imagenVariante = variante.imagen_archivo || imagenGenerica; %>
                                            <% const altText = `${producto.nombre}${variante.color ? `, ${variante.color}` : ''}${variante.talle ? `, talle ${variante.talle}` : ''}`; %>
                                            <a
                                                class="product-variant-preview-item product-variant-slide"
                                                href="<%= url('/producto/' + producto.id) %>"
                                                aria-label="<%= esAdministrador ? 'Editar' : 'Ver' %> <%= altText %>"
                                                title="<%= altText %>"
                                            >
                                                <img
                                                    class="product-image <%= imagenVariante === imagenGenerica ? 'product-image-placeholder' : '' %>"
                                                    src="<%= imagenVariante %>"
                                                    alt="<%= altText %>"
                                                    loading="lazy"
                                                    decoding="async"
                                                    onerror="this.onerror=null;this.src='<%= imagenGenerica %>';this.classList.add('product-image-placeholder')"
                                                >
                                            </a>
                                        <% }) %>
                                    </div>

                                    <% if (slides.length > 1) { %>
                                        <button
                                            type="button"
                                            class="product-carousel-button product-carousel-prev"
                                            data-direction="prev"
                                            aria-label="Ver imagen anterior"
                                        >
                                            <span aria-hidden="true">‹</span>
                                        </button>
                                        <button
                                            type="button"
                                            class="product-carousel-button product-carousel-next"
                                            data-direction="next"
                                            aria-label="Ver imagen siguiente"
                                        >
                                            <span aria-hidden="true">›</span>
                                        </button>
                                    <% } %>
                                </div>

                                <div class="product-content d-flex flex-column flex-grow-1">
                                    <div class="product-category text-uppercase">
                                        <%= categoriaProducto %>
                                    </div>

                                    <h2 id="product-name-<%= producto.id %>" class="product-name">
                                        <a class="product-name-link text-decoration-none" href="<%= url('/producto/' + producto.id) %>">
                                            <%= producto.nombre %>
                                        </a>
                                    </h2>

                                    <p class="product-description">
                                        <%= producto.descripcion %>
                                    </p>

                                    <div class="product-actions mt-auto d-flex align-items-center justify-content-between gap-3">

                                        <a
                                            href="<%= url('/producto/' + producto.id) %>"
                                            class="add-cart-button"
                                            style="flex: 1 1 auto; text-align: center; text-decoration: none;"
                                            aria-label="Ver <%= producto.nombre %><%= productoSinStock ? ', sin stock' : '' %>"
                                        >
                                            <%= productoSinStock ? 'Sin stock' : 'Ver producto' %>
                                        </a>
                                    </div>
                                </div>

                            </article>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="products-empty text-center" role="status">
                    <img class="products-empty-image" src="<%= imagenGenerica %>" alt="" aria-hidden="true">
                    <h2 class="products-empty-title">No hay productos disponibles</h2>
                    <p class="products-empty-description mb-0">
                        Volvé pronto para conocer los próximos ingresos.
                    </p>
                </div>
            <% } %>
        </section>

    </main>

    <%- include('../../partials/site/footer') %>
    <%- include('../../partials/site/sidebar') %>
    <%- include('../../partials/site/initial-state') %>
    <script type="module" defer src="/assets/js/carrito.js"></script>
    <script>
        document.querySelectorAll('[data-carousel]').forEach((carousel) => {
            const track = carousel.querySelector('[data-track]');
            const prevButton = carousel.querySelector('[data-direction="prev"]');
            const nextButton = carousel.querySelector('[data-direction="next"]');

            if (!track || (!prevButton && !nextButton)) {
                return;
            }

            const slides = Array.from(track.children);
            const getCurrentIndex = () => {
                const firstSlide = slides[0];
                if (!firstSlide) return 0;

                const slideWidth = firstSlide.getBoundingClientRect().width;
                if (!slideWidth) return 0;

                return Math.round(track.scrollLeft / slideWidth);
            };

            const move = (direction) => {
                if (slides.length === 0) return;

                const firstSlide = slides[0];
                const slideWidth = firstSlide.getBoundingClientRect().width;
                if (!slideWidth) return;

                const totalSlides = slides.length;
                const currentIndex = getCurrentIndex();
                let nextIndex = currentIndex + direction;

                if (nextIndex >= totalSlides) nextIndex = 0;
                if (nextIndex < 0) nextIndex = totalSlides - 1;

                track.scrollTo({
                    left: nextIndex * slideWidth,
                    behavior: 'smooth'
                });
            };

            prevButton?.addEventListener('click', (event) => {
                event.preventDefault();
                event.stopPropagation();
                move(-1);
            });

            nextButton?.addEventListener('click', (event) => {
                event.preventDefault();
                event.stopPropagation();
                move(1);
            });
        });
    </script>
</body>
</html>
