<%
const variantesProducto = Array.isArray(variantes) ? variantes : [];
const tallesBase = Array.isArray(typeof talles !== 'undefined' ? talles : []) ? (typeof talles !== 'undefined' ? talles : []) : [];
const tallesCatalogo = tallesBase.length > 0
    ? tallesBase.map((talle) => (typeof talle === 'string' ? talle : (talle?.tipo ?? talle?.nombre ?? talle?.talle)))
    : [...new Set(variantesProducto.map((variante) => variante.talle).filter(Boolean))];
const imagenGenerica = '/assets/img/product-placeholder.svg';
const imagenProducto = variantesProducto.find((variante) => variante.imagen_archivo)?.imagen_archivo
    || imagenGenerica;
const usaImagenGenerica = imagenProducto === imagenGenerica;
const normalizarOpcion = (valor) => String(valor || '').trim().toLocaleLowerCase('es');
const colores = [...new Map(
    variantesProducto.map((variante) => [normalizarOpcion(variante.color), variante.color])
).entries()];

const precios = variantesProducto
    .map((variante) => Number(variante.precio))
    .filter(Number.isFinite);
const precioMinimo = precios.length > 0 ? Math.min(...precios) : 0;
const precioMaximo = precios.length > 0 ? Math.max(...precios) : 0;
const formatearPrecio = (precio) => precio.toLocaleString('es-AR', {
    minimumFractionDigits:2,
    maximumFractionDigits:2
});
const precioInicial = precioMinimo === precioMaximo
    ? `$${formatearPrecio(precioMinimo)}`
    : `$${formatearPrecio(precioMinimo)} - $${formatearPrecio(precioMaximo)}`;
const hayStockDisponible = variantesProducto.some(
    (variante) => Number.parseInt(variante.stock, 10) > 0
);
const variantesJson = JSON.stringify(variantesProducto).replace(/</g, '\\u003c');
%>
<!DOCTYPE html>
<html lang="es">
<%- include('../../partials/site/meta') %>
<body id="body-producto">

    <%- include('../../partials/site/navbar') %>

    <main class="product-detail-main w-100 mx-auto">
        <div class="row g-4">
            <div class="col-12 col-lg-7">
                <div class="product-gallery" data-product-gallery>
                    <button
                        type="button"
                        class="product-gallery-control product-gallery-control-prev"
                        data-gallery-direction="prev"
                        aria-label="Ver imagen anterior"
                    >
                        <span aria-hidden="true">‹</span>
                    </button>

                    <div class="product-main-image-container position-relative overflow-hidden">
                        <img
                            id="product-main-image"
                            class="product-main-image position-absolute top-0 start-0 w-100 h-100<%= usaImagenGenerica ? ' product-main-image-placeholder' : '' %>"
                            src="<%= imagenProducto %>"
                            alt="<%= usaImagenGenerica ? 'Producto sin imagen: ' : '' %><%= producto.nombre %>"
                            decoding="async"
                            onerror="this.onerror=null;this.src='<%= imagenGenerica %>';this.classList.add('product-main-image-placeholder')"
                        >
                    </div>

                    <button
                        type="button"
                        class="product-gallery-control product-gallery-control-next"
                        data-gallery-direction="next"
                        aria-label="Ver imagen siguiente"
                    >
                        <span aria-hidden="true">›</span>
                    </button>

                    <div id="product-gallery-thumbs" class="product-gallery-thumbs" aria-label="Miniaturas del producto"></div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <section class="product-detail-info d-flex flex-column" aria-labelledby="product-detail-title">
                    <div class="product-detail-category">
                        <%= producto.categoria_producto || 'Sin categoria' %>
                    </div>

                    <h1 id="product-detail-title" class="product-detail-title">
                        <%= producto.nombre %>
                    </h1>

                    <p id="product-detail-price" class="product-detail-price">
                        <%= precioInicial %>
                    </p>

                    <div class="product-detail-description-container">
                        <p class="product-detail-description"><%= producto.descripcion %></p>

                        <p
                            id="product-stock-status"
                            class="product-stock d-flex align-items-center gap-2 mb-0<%= hayStockDisponible ? '' : ' product-stock-unavailable' %>"
                            aria-live="polite"
                        >
                            <span class="product-stock-indicator" aria-hidden="true"></span>
                            <span data-stock-text>
                                <%= hayStockDisponible ? 'Selecciona un color' : 'Sin stock disponible' %>
                            </span>
                        </p>
                    </div>

                    <div class="product-options border-top border-bottom">
                        <div class="product-option-group">
                            <div class="d-flex justify-content-between align-items-center product-size-header">
                                <span class="product-size-label" id="product-color-label">Color</span>
                                <span class="product-size-help" id="product-color-help">Elegi una opcion</span>
                            </div>

                            <div
                                class="product-color-options"
                                role="group"
                                aria-labelledby="product-color-label"
                                aria-describedby="product-color-help"
                            >
                                <% colores.forEach(([colorKey, color]) => { %>
                                    <button
                                        class="product-color-button"
                                        type="button"
                                        data-color="<%= color %>"
                                        data-color-key="<%= colorKey %>"
                                        aria-pressed="false"
                                    >
                                        <span class="product-color-swatch" aria-hidden="true"></span>
                                        <span><%= color %></span>
                                    </button>
                                <% }) %>
                            </div>
                        </div>

                        <div class="product-option-group">
                            <div class="d-flex justify-content-between align-items-center product-size-header">
                                <span class="product-size-label" id="product-size-label">Talle</span>
                                <span class="product-size-help" id="product-size-help">Primero elegi un color</span>
                            </div>

                            <div
                                class="d-flex flex-wrap product-size-options"
                                role="group"
                                aria-labelledby="product-size-label"
                                aria-describedby="product-size-help"
                            >
                                <% tallesCatalogo.forEach((talle) => { %>
                                    <% const talleLabel = String(talle); %>
                                    <button
                                        class="product-size-button"
                                        type="button"
                                        data-talle="<%= talleLabel %>"
                                        data-talle-key="<%= normalizarOpcion(talleLabel) %>"
                                        aria-pressed="false"
                                        disabled
                                    ><%= talleLabel %></button>
                                <% }) %>
                            </div>
                        </div>
                    </div>

                    <button
                        id="product-add-cart"
                        class="product-add-cart-button btn-agregar-al-carrito w-100 d-flex align-items-center justify-content-center text-uppercase"
                        type="button"
                        data-producto=""
                        aria-describedby="product-stock-status"
                        disabled
                    >
                        <%= hayStockDisponible ? 'Selecciona color y talle' : 'Sin stock' %>
                    </button>

                    <div class="product-accordions">
                        <details class="product-accordion border-bottom" open>
                            <summary class="product-accordion-summary d-flex justify-content-between align-items-center">
                                <span>Material y cuidados</span>
                                <svg class="accordion-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="m7.41 8.59 4.59 4.58 4.59-4.58L18 10l-6 6-6-6 1.41-1.41Z"></path>
                                </svg>
                            </summary>
                            <div class="product-accordion-content">
                                Consulta la etiqueta interior de la prenda para conocer las instrucciones especificas de lavado y cuidado.
                            </div>
                        </details>

                        <details class="product-accordion border-bottom">
                            <summary class="product-accordion-summary d-flex justify-content-between align-items-center">
                                <span>Envios y devoluciones</span>
                                <svg class="accordion-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="m7.41 8.59 4.59 4.58 4.59-4.58L18 10l-6 6-6-6 1.41-1.41Z"></path>
                                </svg>
                            </summary>
                            <div class="product-accordion-content">
                                Los plazos y condiciones aplicables se informaran antes de confirmar la compra.
                            </div>
                        </details>
                    </div>
                </section>
            </div>
        </div>
    </main>

    <script id="product-variants-data" type="application/json"><%- variantesJson %></script>
    <%- include('../../partials/site/sidebar') %>
    <%- include('../../partials/site/footer') %>
    <%- include('../../partials/site/initial-state') %>
    <script type="module" defer src="/assets/js/carrito.js"></script>
    <script type="module" defer src="/assets/js/producto.js"></script>
</body>
</html>
