<!DOCTYPE html>
<html lang="es">
<%- include('../partials/meta') %>
<body>
    <!-- <%- include('../partials/navbar') %> -->
     <section id="form-new-product">
        <% if (product_message?.message) { %>
            <div
                class="alert <%= product_message.type === 'success' ? 'alert-success' : 'alert-danger' %>"
                role="alert"
            >
                <%= product_message.message %>
            </div>
        <% } %>

        <form
            id="form-create-product"
            method="post"
            action="<%= url('/productos/crear') %>"
            enctype="multipart/form-data"
        >
            <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
            
            <div class="mb-3">
                <label for="name" class="form-label">Nombre</label>
                <input type="text" name="nombre" class="form-control" id="name" value="<%= form_data.nombre || '' %>" required>
            </div>
            
            <div class="mb-3">
                <label for="description" class="form-label">Descripcion</label>
                <input type="text" name="descripcion" class="form-control" id="description" value="<%= form_data.descripcion || '' %>" required>
            </div>

            <div class="mb-3">
                <label for="size" class="form-label">Talle</label>
                <select name="talle" class="form-select" id="size" required>
                    <option value="" <%= form_data.talle ? '' : 'selected' %> disabled>Seleccionar talle</option>
                    <!-- <option value="S">S</option>
                    <option value="M">M</option>
                    <option value="L">L</option>
                    <option value="XL">XL</option> -->
                    <% talles.forEach(talle => { %>
                        <option value="<%= talle.id %>" <%= String(form_data.talle || '') === String(talle.id) ? 'selected' : '' %>><%= talle.tipo %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class="mb-3">
                <label for="stock" class="form-label">Stock</label>
                <input type="number" name="stock" class="form-control" id="stock" min="0" step="1" value="<%= form_data.stock ?? '' %>" required>
            </div>
            
            <div class="mb-3">
                <label for="price" class="form-label">Precio</label>
                <input type="number" name="precio" class="form-control" id="price" min="0" step="0.01" value="<%= form_data.precio ?? '' %>" required>
            </div>
            
            <div class="mb-3">
                <label for="category" class="form-label">Categoría</label>
                <select name="categoria" class="form-select" id="category" required>
                    <option value="" <%= form_data.categoria ? '' : 'selected' %> disabled>Seleccionar categoría</option>
                    <% categorias.forEach(categoria => { %>
                        <option value="<%= categoria.id %>" <%= String(form_data.categoria || '') === String(categoria.id) ? 'selected' : '' %>><%= categoria.nombre %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class="mb-3">
                <label for="images" class="form-label">Imágenes</label>
                <input
                    type="file"
                    class="form-control"
                    id="images"
                    name="imagenes"
                    accept="image/jpeg,image/png,image/gif,image/svg+xml,.jpg,.jpeg,.png,.gif,.svg"
                    multiple
                >
                <div class="form-text">Hasta 8 imágenes de 5 MB cada una.</div>
            </div>
            
            <button type="submit" class="btn btn-primary">Crear producto</button>
        </form>
     </section>
</body>
</html>
