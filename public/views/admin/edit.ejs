<%
const variantesProducto = Array.isArray(variantes) ? variantes : [];
const imagenesProducto = Array.isArray(imagenes) ? imagenes : [];
const variantePrincipal = variantesProducto[0] || null;
const datosFormulario = typeof form_data !== 'undefined' && form_data ? form_data : {};
const valorCampo = (campo, valorActual = '') => Object.prototype.hasOwnProperty.call(datosFormulario, campo)
    ? datosFormulario[campo] ?? ''
    : valorActual ?? '';
const imagenesMarcadas = new Set(
    (Array.isArray(datosFormulario.eliminar_imagenes)
        ? datosFormulario.eliminar_imagenes
        : datosFormulario.eliminar_imagenes
            ? [datosFormulario.eliminar_imagenes]
            : []
    ).map(String)
);
const varianteId = valorCampo('variante_id', variantePrincipal?.variante_id || '');
const talleSeleccionado = valorCampo('talle', variantePrincipal?.talle_id || '');
const stockActual = valorCampo('stock', variantePrincipal?.stock ?? producto.stock);
const precioActual = valorCampo('precio', variantePrincipal?.precio ?? producto.precio);
%>
<!DOCTYPE html>
<html lang="es">
<%- include('../../partials/admin/admin-meta') %>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
        <%- include('../../partials/admin/admin-navbar') %>
        <%- include('../../partials/admin/admin-sidebar', { activePage: 'products' }) %>

        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row align-items-center gy-2">
                        <div class="col-sm-7">
                            <h1 class="mb-0 fs-3">Editar producto</h1>
                        </div>
                        <div class="col-sm-5">
                            <ol class="breadcrumb float-sm-end mb-0">
                                <li class="breadcrumb-item">
                                    <a href="<%= url('/admin/productos') %>">Productos</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="<%= url('/admin/productos/' + producto.id) %>"><%= producto.nombre %></a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">Editar</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-content">
                <div class="container-fluid pb-4">
                    <%- include('../../partials/admin/product-message') %>

                    <form
                        id="form-edit-product"
                        method="post"
                        action="<%= url('/admin/productos/actualizar') %>"
                        enctype="multipart/form-data"
                    >
                        <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                        <input type="hidden" name="id" value="<%= producto.id %>">
                        <input type="hidden" name="variante_id" value="<%= varianteId %>">

                        <div class="row g-4">
                            <div class="col-12 col-xl-7">
                                <section class="card card-primary card-outline" aria-labelledby="product-fields-title">
                                    <div class="card-header">
                                        <h2 id="product-fields-title" class="card-title">Informacion del producto</h2>
                                    </div>

                                    <div class="card-body">
                                        <div class="row g-3">
                                            <div class="col-12 col-md-7">
                                                <label for="name" class="form-label">Nombre</label>
                                                <input
                                                    type="text"
                                                    name="nombre"
                                                    class="form-control"
                                                    id="name"
                                                    maxlength="150"
                                                    value="<%= valorCampo('nombre', producto.nombre) %>"
                                                    required
                                                >
                                            </div>

                                            <div class="col-12 col-md-5">
                                                <label for="category" class="form-label">Categoria</label>
                                                <select name="categoria" class="form-select" id="category" required>
                                                    <option value="" disabled>Seleccionar categoria</option>
                                                    <% categorias.forEach((categoria) => { %>
                                                        <option
                                                            value="<%= categoria.id %>"
                                                            <%= String(valorCampo('categoria', producto.categoria)) === String(categoria.id) ? 'selected' : '' %>
                                                        ><%= categoria.nombre %></option>
                                                    <% }) %>
                                                </select>
                                            </div>

                                            <div class="col-12 col-sm-4">
                                                <label for="size" class="form-label">Talle</label>
                                                <select name="talle" class="form-select" id="size" required>
                                                    <option value="" disabled>Seleccionar talle</option>
                                                    <% talles.forEach((talle) => { %>
                                                        <option
                                                            value="<%= talle.id %>"
                                                            <%= String(talleSeleccionado) === String(talle.id) ? 'selected' : '' %>
                                                        ><%= talle.tipo %></option>
                                                    <% }) %>
                                                </select>
                                            </div>

                                            <div class="col-12 col-sm-4">
                                                <label for="stock" class="form-label">Stock</label>
                                                <div class="input-group">
                                                    <span class="input-group-text"><i class="bi bi-boxes" aria-hidden="true"></i></span>
                                                    <input
                                                        type="number"
                                                        name="stock"
                                                        class="form-control"
                                                        id="stock"
                                                        min="0"
                                                        step="1"
                                                        value="<%= stockActual %>"
                                                        required
                                                    >
                                                </div>
                                            </div>

                                            <div class="col-12 col-sm-4">
                                                <label for="price" class="form-label">Precio</label>
                                                <div class="input-group">
                                                    <span class="input-group-text">$</span>
                                                    <input
                                                        type="number"
                                                        name="precio"
                                                        class="form-control"
                                                        id="price"
                                                        min="0"
                                                        step="0.01"
                                                        value="<%= precioActual %>"
                                                        required
                                                    >
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </section>
                            </div>

                            <div class="col-12 col-xl-5">
                                <section class="card h-100" aria-labelledby="product-current-images-title">
                                    <div class="card-header d-flex align-items-center justify-content-between">
                                        <h2 id="product-current-images-title" class="card-title mb-0">Imagenes actuales</h2>
                                        <span class="badge text-bg-secondary"><%= imagenesProducto.length %></span>
                                    </div>

                                    <div class="card-body">
                                        <% if (imagenesProducto.length > 0) { %>
                                            <div class="row g-3">
                                                <% imagenesProducto.forEach((imagen, index) => { %>
                                                    <div class="<%= index === 0 ? 'col-12' : 'col-6' %>">
                                                        <div class="border rounded overflow-hidden bg-body-secondary">
                                                            <div class="ratio <%= index === 0 ? 'ratio-4x3' : 'ratio-1x1' %>">
                                                                <img
                                                                    class="w-100 h-100 object-fit-contain"
                                                                    src="<%= imagen.url %>"
                                                                    alt="<%= imagen.nombre_original || producto.nombre %>"
                                                                    loading="<%= index === 0 ? 'eager' : 'lazy' %>"
                                                                    decoding="async"
                                                                >
                                                            </div>
                                                            <div class="form-check p-2 ps-4 bg-body">
                                                                <input
                                                                    class="form-check-input"
                                                                    type="checkbox"
                                                                    name="eliminar_imagenes"
                                                                    value="<%= imagen.id %>"
                                                                    id="delete-image-<%= imagen.id %>"
                                                                    <%= imagenesMarcadas.has(String(imagen.id)) ? 'checked' : '' %>
                                                                >
                                                                <label class="form-check-label small" for="delete-image-<%= imagen.id %>">
                                                                    Eliminar esta imagen
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <div class="ratio ratio-4x3 rounded border bg-body-secondary mb-3">
                                                <div class="d-flex flex-column align-items-center justify-content-center text-body-secondary">
                                                    <i class="bi bi-image fs-1 mb-2" aria-hidden="true"></i>
                                                    <span>Este producto no tiene imagenes</span>
                                                </div>
                                            </div>
                                        <% } %>

                                        <div class="mt-3">
                                            <label for="images" class="form-label">Agregar nuevas imagenes</label>
                                            <input
                                                type="file"
                                                class="form-control"
                                                id="images"
                                                name="imagenes"
                                                accept="image/jpeg,image/png,image/gif,image/svg+xml,.jpg,.jpeg,.png,.gif,.svg"
                                                multiple
                                                aria-describedby="images-help"
                                            >
                                            <div id="images-help" class="form-text">
                                                Las imagenes actuales se conservan salvo que las marques para eliminar. Maximo 8 imagenes de 5 MB.
                                            </div>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                            <a class="btn btn-outline-secondary" href="<%= url('/admin/productos/' + producto.id) %>">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                                Guardar cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </main>

        <%- include('../../partials/admin/admin-footer') %>
    </div>

    <%- include('../../partials/admin/admin-scripts') %>
</body>
</html>
