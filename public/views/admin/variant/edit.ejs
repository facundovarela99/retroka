<%
const datosFormulario = typeof form_data !== 'undefined' && form_data ? form_data : {};
const valorCampo = (campo, actual) => Object.prototype.hasOwnProperty.call(datosFormulario, campo)
    ? datosFormulario[campo] ?? ''
    : actual;
const tallesDeOtrasVariantes = new Set(
    (Array.isArray(variantes) ? variantes : [])
        .filter((item) => Number(item.variante_id) !== Number(variante.variante_id))
        .map((item) => String(item.talle_id))
);
const talleSeleccionado = String(valorCampo('talle', variante.talle_id));
const imagenProducto = producto.imagen_archivo || '/assets/img/product-placeholder.svg';
%>
<!DOCTYPE html>
<html lang="es">
<%- include('../../../partials/admin/admin-meta') %>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
        <%- include('../../../partials/admin/admin-navbar') %>
        <%- include('../../../partials/admin/admin-sidebar', { activePage: 'products' }) %>

        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row align-items-center gy-2">
                        <div class="col-sm-7">
                            <h1 class="mb-0 fs-3">Editar variante</h1>
                        </div>
                        <div class="col-sm-5">
                            <ol class="breadcrumb float-sm-end mb-0">
                                <li class="breadcrumb-item">
                                    <a href="<%= url('/admin/productos') %>">Productos</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="<%= url('/admin/productos/' + producto.id) %>"><%= producto.nombre %></a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">Editar variante</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-content">
                <div class="container-fluid pb-4">
                    <%- include('../../../partials/admin/product-message') %>

                    <div class="row justify-content-center g-4">
                        <div class="col-12 col-lg-4 col-xl-3">
                            <aside class="card h-100" aria-labelledby="variant-product-title">
                                <div class="ratio ratio-4x3 bg-body-secondary rounded-top overflow-hidden">
                                    <img
                                        class="w-100 h-100 object-fit-contain"
                                        src="<%= imagenProducto %>"
                                        alt="<%= producto.imagen_archivo ? producto.nombre : 'Producto sin imagen' %>"
                                    >
                                </div>
                                <div class="card-body">
                                    <h2 id="variant-product-title" class="fs-5"><%= producto.nombre %></h2>
                                    <p class="text-body-secondary mb-0">
                                        Variante #<%= variante.variante_id %>. Las imágenes pertenecen al producto y no se modifican aquí.
                                    </p>
                                </div>
                            </aside>
                        </div>

                        <div class="col-12 col-lg-8 col-xl-6">
                            <form
                                id="form-edit-variant"
                                method="post"
                                action="<%= url('/admin/productos/' + producto.id + '/variantes/' + variante.variante_id) %>"
                            >
                                <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                                <input type="hidden" name="producto_id" value="<%= producto.id %>">
                                <input type="hidden" name="variante_id" value="<%= variante.variante_id %>">

                                <section class="card card-warning card-outline" aria-labelledby="variant-fields-title">
                                    <div class="card-header">
                                        <h2 id="variant-fields-title" class="card-title">Datos de la variante</h2>
                                    </div>

                                    <div class="card-body">
                                        <div class="row g-3">
                                            <div class="col-12">
                                                <label for="variant-size" class="form-label">Talle</label>
                                                <select name="talle" class="form-select" id="variant-size" required>
                                                    <option value="" disabled>Seleccionar talle</option>
                                                    <% talles.forEach((talle) => { %>
                                                        <%
                                                        const usadoPorOtraVariante = tallesDeOtrasVariantes.has(String(talle.id));
                                                        const estaSeleccionado = talleSeleccionado === String(talle.id);
                                                        %>
                                                        <option
                                                            value="<%= talle.id %>"
                                                            <%= estaSeleccionado ? 'selected' : '' %>
                                                            <%= usadoPorOtraVariante ? 'disabled' : '' %>
                                                        >
                                                            <%= talle.tipo %><%= usadoPorOtraVariante ? ' — ya agregado' : '' %>
                                                        </option>
                                                    <% }) %>
                                                </select>
                                            </div>

                                            <div class="col-12 col-sm-6">
                                                <label for="variant-stock" class="form-label">Stock</label>
                                                <div class="input-group">
                                                    <span class="input-group-text">
                                                        <i class="bi bi-boxes" aria-hidden="true"></i>
                                                    </span>
                                                    <input
                                                        type="number"
                                                        name="stock"
                                                        class="form-control"
                                                        id="variant-stock"
                                                        min="0"
                                                        step="1"
                                                        value="<%= valorCampo('stock', variante.stock) %>"
                                                        required
                                                    >
                                                </div>
                                            </div>

                                            <div class="col-12 col-sm-6">
                                                <label for="variant-price" class="form-label">Precio</label>
                                                <div class="input-group">
                                                    <span class="input-group-text">$</span>
                                                    <input
                                                        type="number"
                                                        name="precio"
                                                        class="form-control"
                                                        id="variant-price"
                                                        min="0"
                                                        max="99999999.99"
                                                        step="0.01"
                                                        value="<%= valorCampo('precio', variante.precio) %>"
                                                        required
                                                    >
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card-footer d-flex flex-wrap justify-content-between gap-2">
                                        <button
                                            type="submit"
                                            class="btn btn-outline-danger"
                                            form="form-delete-variant"
                                        >
                                            <i class="bi bi-trash me-1" aria-hidden="true"></i>
                                            Eliminar variante
                                        </button>

                                        <div class="d-flex flex-wrap gap-2">
                                            <a class="btn btn-outline-secondary" href="<%= url('/admin/productos/' + producto.id) %>">
                                                Cancelar
                                            </a>
                                            <button type="submit" class="btn btn-warning">
                                                <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                                                Guardar cambios
                                            </button>
                                        </div>
                                    </div>
                                </section>
                            </form>

                            <form
                                id="form-delete-variant"
                                method="post"
                                action="<%= url('/admin/productos/' + producto.id + '/variantes/' + variante.variante_id + '/eliminar') %>"
                            >
                                <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                                <input type="hidden" name="producto_id" value="<%= producto.id %>">
                                <input type="hidden" name="variante_id" value="<%= variante.variante_id %>">
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../../partials/admin/admin-footer') %>
    </div>

    <%- include('../../../partials/admin/admin-scripts') %>
</body>
</html>
