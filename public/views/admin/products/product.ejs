<%
const variantesProducto = Array.isArray(variantes) ? variantes : [];
const stockTotal = variantesProducto.reduce((total, variante) => {
    const stock = Number.parseInt(variante.stock, 10);
    return total + (Number.isFinite(stock) ? Math.max(stock, 0) : 0);
}, 0);
const formatearPrecio = (valor) => {
    const precio = Number(valor);

    return Number.isFinite(precio)
        ? precio.toLocaleString('es-AR', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        })
        : '0,00';
};
%>
<!DOCTYPE html>
<html lang="es">
<%- include('../../../partials/admin/admin-meta') %>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
        <%- include('../../../partials/admin/admin-navbar') %>
        <%- include('../../../partials/admin/admin-sidebar', { activePage: 'products' }) %>

        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row align-items-center gy-2">
                        <div class="col-sm-8">
                            <h1 class="mb-0 fs-3"><%= producto.nombre %></h1>
                        </div>
                        <div class="col-sm-4">
                            <ol class="breadcrumb float-sm-end mb-0">
                                <li class="breadcrumb-item">
                                    <a href="<%= url('/admin/productos') %>">Productos</a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">Detalle</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-content">
                <div class="container-fluid pb-4">
                    <%- include('../../../partials/admin/product-message') %>

                    <div class="row g-4">
                        <div class="col-12 col-xl-5">
                            <section class="card card-primary card-outline h-100" aria-labelledby="product-info-title">
                                <div class="card-header">
                                    <h2 id="product-info-title" class="card-title">Información general</h2>
                                </div>

                                <div class="card-body">
                                    <p class="text-body-secondary"><%= producto.descripcion || 'Sin descripcion' %></p>

                                    <dl class="mb-0">
                                        <div class="d-flex justify-content-between gap-3 py-3 border-bottom">
                                            <dt class="fw-semibold">Categoria</dt>
                                            <dd class="mb-0 text-end"><%= producto.categoria_producto || 'Sin categoria' %></dd>
                                        </div>
                                        <div class="d-flex justify-content-between gap-3 py-3 border-bottom">
                                            <dt class="fw-semibold">Stock total</dt>
                                            <dd class="mb-0 text-end">
                                                <span class="badge <%= stockTotal > 0 ? 'text-bg-success' : 'text-bg-danger' %>">
                                                    <%= stockTotal %>
                                                </span>
                                            </dd>
                                        </div>
                                        <div class="d-flex justify-content-between gap-3 pt-3">
                                            <dt class="fw-semibold">Variantes activas</dt>
                                            <dd class="mb-0 text-end"><%= variantesProducto.length %></dd>
                                        </div>
                                    </dl>
                                </div>

                                <div class="card-footer d-flex flex-wrap justify-content-end gap-2">
                                    <% if (variantesProducto.length > 0) { %>
                                        <a class="btn btn-outline-secondary" href="<%= url('/producto/' + producto.id) %>">
                                            <i class="bi bi-shop me-1" aria-hidden="true"></i>
                                            Ver en tienda
                                        </a>
                                    <% } else { %>
                                        <button class="btn btn-outline-secondary" type="button" disabled>
                                            <i class="bi bi-shop me-1" aria-hidden="true"></i>
                                            Sin variantes para publicar
                                        </button>
                                    <% } %>
                                    <a class="btn btn-outline-warning" href="<%= url('/admin/producto/edit/' + producto.id) %>">
                                        <i class="fas fa-pencil-alt me-1" aria-hidden="true"></i>
                                        Editar
                                    </a>
                                    <a class="btn btn-outline-primary" href="<%= url('/admin/productos') %>">
                                        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                                        Volver
                                    </a>
                                </div>
                            </section>
                        </div>
                    </div>

                    <section class="mt-4" aria-labelledby="product-variants-title">
                        <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3">
                            <h2 id="product-variants-title" class="fs-5 mb-0">Variantes</h2>
                            <a class="btn btn-sm btn-outline-primary" href="<%= url('/admin/productos/' + producto.id + '/variantes/nueva') %>">
                                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                                Nueva variante
                            </a>
                        </div>

                        <% if (variantesProducto.length > 0) { %>
                            <div class="row g-3">
                                <% variantesProducto.forEach((variante) => { %>
                                    <%
                                    const imagenesVariante = Array.isArray(variante.imagenes)
                                        ? variante.imagenes
                                        : [];
                                    const carouselId = `variant-images-${variante.variante_id}`;
                                    %>
                                    <div class="col-12 col-sm-6 col-xl-4">
                                        <article class="card h-100">
                                            <div class="card-body">
                                                <div
                                                    id="<%= carouselId %>"
                                                    class="carousel slide mb-3 border bg-body-secondary overflow-hidden"
                                                    aria-label="Imagenes de <%= producto.nombre %>, <%= variante.color %>, talle <%= variante.talle %>"
                                                >
                                                    <div class="carousel-inner ratio ratio-4x3">
                                                        <% if (imagenesVariante.length > 0) { %>
                                                            <% imagenesVariante.forEach((imagen, index) => { %>
                                                                <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                                                    <img
                                                                        class="d-block w-100 h-100 object-fit-cover"
                                                                        src="<%= imagen.url %>"
                                                                        alt="<%= imagen.nombre_original || producto.nombre %>"
                                                                        loading="lazy"
                                                                    >
                                                                </div>
                                                            <% }) %>
                                                        <% } else { %>
                                                            <div class="carousel-item active">
                                                                <img
                                                                    class="d-block w-100 h-100 object-fit-contain p-4"
                                                                    src="/assets/img/product-placeholder.svg"
                                                                    alt="Variante sin imagen"
                                                                >
                                                            </div>
                                                        <% } %>
                                                    </div>

                                                    <% if (imagenesVariante.length > 1) { %>
                                                        <button
                                                            class="carousel-control-prev"
                                                            type="button"
                                                            data-bs-target="#<%= carouselId %>"
                                                            data-bs-slide="prev"
                                                            aria-label="Imagen anterior"
                                                        >
                                                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                                        </button>
                                                        <button
                                                            class="carousel-control-next"
                                                            type="button"
                                                            data-bs-target="#<%= carouselId %>"
                                                            data-bs-slide="next"
                                                            aria-label="Imagen siguiente"
                                                        >
                                                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                                        </button>
                                                    <% } %>
                                                </div>

                                                <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                                                    <div>
                                                        <p class="text-body-secondary small mb-1">Talle</p>
                                                        <h3 class="fs-5 mb-0"><%= variante.talle || 'Sin talle' %></h3>
                                                    </div>
                                                    <span class="badge <%= Number(variante.stock) > 0 ? 'text-bg-success' : 'text-bg-danger' %>">
                                                        <%= Number(variante.stock) > 0 ? 'Disponible' : 'Sin stock' %>
                                                    </span>
                                                </div>

                                                <div class="d-flex justify-content-between gap-3 py-2 border-top">
                                                    <span class="text-body-secondary">Color</span>
                                                    <strong><%= variante.color || 'Sin color' %></strong>
                                                </div>
                                                <div class="d-flex justify-content-between gap-3 py-2 border-top">
                                                    <span class="text-body-secondary">Stock</span>
                                                    <strong><%= variante.stock %></strong>
                                                </div>
                                                <div class="d-flex justify-content-between gap-3 pt-2 border-top">
                                                    <span class="text-body-secondary">Precio</span>
                                                    <strong>$<%= formatearPrecio(variante.precio) %></strong>
                                                </div>
                                            </div>
                                            <div class="card-footer d-flex flex-wrap justify-content-end gap-2">
                                                <a
                                                    class="btn btn-sm btn-outline-warning"
                                                    href="<%= url('/admin/productos/' + producto.id + '/variantes/' + variante.variante_id + '/editar') %>"
                                                >
                                                    <i class="bi bi-pencil me-1" aria-hidden="true"></i>
                                                    Editar
                                                </a>
                                                <form
                                                    method="post"
                                                    action="<%= url('/admin/productos/' + producto.id + '/variantes/' + variante.variante_id + '/eliminar') %>"
                                                    data-loader-on-submit
                                                    >
                                                    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                                                    <input type="hidden" name="producto_id" value="<%= producto.id %>">
                                                    <input type="hidden" name="variante_id" value="<%= variante.variante_id %>">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash me-1" aria-hidden="true"></i>
                                                        Eliminar
                                                    </button>
                                                </form>
                                            </div>
                                        </article>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="border rounded p-4 text-center text-body-secondary">
                                <i class="bi bi-box-seam fs-2 d-block mb-2" aria-hidden="true"></i>
                                Este producto no tiene variantes activas.
                            </div>
                        <% } %>
                    </section>
                </div>
            </div>
        </main>

        <%- include('../../../partials/admin/admin-footer') %>
    </div>

    <%- include('../../../partials/admin/admin-loader') %>
    <%- include('../../../partials/admin/admin-scripts') %>
</body>
</html>
